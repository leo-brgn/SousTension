# ---------------------------------------------------------------
# Line endings: normalise text to LF in the repo
# ---------------------------------------------------------------
* text=auto

# ---------------------------------------------------------------
# Unity text assets: force LF and use UnityYAMLMerge for merges
# (configure the merge driver once per clone: see CLAUDE.md / README)
#   git config merge.unityyamlmerge.name "Unity SmartMerge (UnityYAMLMerge)"
#   git config merge.unityyamlmerge.driver "'<Unity>/Editor/Data/Tools/UnityYAMLMerge.exe' merge -h -p --force %O %B %A %A"
# ---------------------------------------------------------------
*.cs        text diff=csharp eol=lf
*.shader    text eol=lf
*.cginc     text eol=lf
*.hlsl      text eol=lf
*.asmdef    text eol=lf
*.asmref    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.meta      text eol=lf
*.unity     merge=unityyamlmerge text eol=lf
*.prefab    merge=unityyamlmerge text eol=lf
*.asset     merge=unityyamlmerge text eol=lf
*.mat       merge=unityyamlmerge text eol=lf
*.anim      merge=unityyamlmerge text eol=lf
*.controller merge=unityyamlmerge text eol=lf
*.overrideController merge=unityyamlmerge text eol=lf
*.physicMaterial merge=unityyamlmerge text eol=lf
*.physicsMaterial2D merge=unityyamlmerge text eol=lf
*.playable  merge=unityyamlmerge text eol=lf
*.mask      merge=unityyamlmerge text eol=lf
*.brush     merge=unityyamlmerge text eol=lf
*.flare     merge=unityyamlmerge text eol=lf
*.fontsettings merge=unityyamlmerge text eol=lf
*.guiskin   merge=unityyamlmerge text eol=lf
*.giparams  merge=unityyamlmerge text eol=lf
*.renderTexture merge=unityyamlmerge text eol=lf
*.spriteatlas merge=unityyamlmerge text eol=lf
*.terrainlayer merge=unityyamlmerge text eol=lf
*.mixer     merge=unityyamlmerge text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.inputactions text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

